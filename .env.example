# Set this to the canonical domain you own and have configured in DNS.
NEXT_PUBLIC_SITE_URL=https://toolixaza.com

# Admin / SaaS infrastructure
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
NEXTAUTH_URL="https://your-real-domain.example"
NEXTAUTH_SECRET="generate-a-long-random-secret-before-deploying"
ADMIN_EMAIL="admin@your-real-domain.example"
# bcrypt hash of the admin password; never put a plain password in this file
ADMIN_PASSWORD_HASH=""
# Set ADMIN_EMAIL and ADMIN_PASSWORD_HASH in your hosting provider's secret settings.
# Generate hash locally with: node scripts/hash-admin-password.cjs "your-long-unique-password"
# Do not commit real credentials or a real .env file.
